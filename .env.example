# Copy to .env at the repo root. See README.md "Environment Variables" for full details.
# Never commit .env or reuse a funded Mainnet key for testnet development.

# --- Shared (deploy/bootstrap scripts, apps/indexer) ---
# testnet (default) or mainnet
NETWORK=testnet
# Soroban RPC endpoint. Defaults based on NETWORK if unset.
RPC_URL=
# Overrides the network passphrase; defaults based on NETWORK.
NETWORK_PASSPHRASE=

# --- Deployment (scripts/deploy.ts, scripts/bootstrap_liquidity.ts) ---
# Amount used to seed initial vault/marketplace liquidity.
BOOTSTRAP_AMOUNT=
# If set, skips the liquidity bootstrap step.
SKIP_BOOTSTRAP=

# --- Frontend (apps/web) ---
# Soroban RPC endpoint the browser client talks to.
NEXT_PUBLIC_RPC_URL=
# Network label surfaced to the client.
NEXT_PUBLIC_NETWORK=
# Passphrase used by client-side transaction building.
NEXT_PUBLIC_NETWORK_PASSPHRASE=
# URL of the deployed Mintlify documentation site (apps/docs). Used by the navbar
# "Docs" link, hero "Read more" CTA, and JoinIn's "Docs" link. Not yet configured
# for production — see apps/docs/README.md for what's required to deploy it.
NEXT_PUBLIC_DOCS_URL=

# --- Database (prisma, shared by apps/web + apps/indexer) ---
# Postgres connection string (e.g. Neon).
DATABASE_URL=
# Unpooled Postgres connection string, for migrations/uses that can't use pgbouncer.
DATABASE_URL_UNPOOLED=
